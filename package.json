{
  "name": "bossai-funding-workspace",
  "version": "0.49.0",
  "private": true,
  "description": "BossAI Funding — owner capital decision and execution workspace",
  "license": "AGPL-3.0-or-later",
  "author": "BossAI",
  "homepage": "https://github.com/liufeng1976/bossai-funding-workspace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liufeng1976/bossai-funding-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/liufeng1976/bossai-funding-workspace/issues"
  },
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && node dist/src/server/main.js",
    "start": "node dist/src/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:journey": "node --test --experimental-strip-types tests/journey.test.ts",
    "test:chrome-repair": "node scripts/chrome-repair-smoke.cjs",
    "test:ui-browser": "node scripts/ui-browser-acceptance.cjs",
    "test:owner-mobile": "node scripts/ui-browser-acceptance.cjs --mobile-owner-readiness",
    "test:locales": "node scripts/ui-browser-acceptance.cjs --locale-acceptance",
    "test:locale-leaks": "node scripts/ui-browser-acceptance.cjs --locale-leak-audit",
    "test:desktop-contract": "node --test --experimental-strip-types tests/desktop-distribution-contract.test.ts tests/open-source-readiness.test.ts",
    "desktop:run": "npm run build && npx --yes electron@43.4.1 .",
    "desktop:smoke": "npm run build && node scripts/desktop-smoke.cjs",
    "desktop:commercial-smoke": "npm run build && node scripts/desktop-commercial-entitlement-smoke.cjs",
    "desktop:pack": "npm run build && npx --yes electron-builder@26.15.3 --dir",
    "desktop:installer": "npm run build && npx --yes electron-builder@26.15.3 --win nsis",
    "desktop:packaged-smoke": "node scripts/desktop-packaged-smoke.cjs",
    "desktop:commercial-packaged-smoke": "node scripts/desktop-commercial-entitlement-smoke.cjs --packaged",
    "desktop:installer-lifecycle": "node scripts/desktop-installer-lifecycle.cjs",
    "verify:desktop": "npm run test:desktop-contract && npm run desktop:smoke && npm run desktop:commercial-smoke",
    "verify:desktop-package": "npm run desktop:pack && npm run desktop:packaged-smoke && npm run desktop:commercial-packaged-smoke",
    "verify:desktop-installer": "npm run desktop:installer && npm run desktop:installer-lifecycle",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:owner-readiness": "npm run verify && npm run test:ui-browser && npm run test:owner-mobile && npm run test:locales && npm run test:locale-leaks && npm run test:chrome-repair"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
